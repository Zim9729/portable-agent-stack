{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release documentation coverage",
  "type": "object",
  "required": ["status", "mode", "baseCommit", "currentCommit", "surfaces"],
  "properties": {
    "status": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED"]},
    "mode": {"enum": ["check", "apply", "release"]},
    "baseCommit": {"type": "string"},
    "currentCommit": {"type": "string"},
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "change", "documentationStatus"],
        "properties": {
          "name": {"type": "string"},
          "change": {"enum": ["added", "changed", "deprecated", "removed"]},
          "documentationStatus": {"enum": ["current", "updated", "missing", "stale", "not-applicable"]},
          "documents": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
